@page "/actualizar-libros"
@rendermode InteractiveServer

@using BlazorBiblioteca.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms

@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Actualizar Libro</h3>

<!-- Buscar libro por ID -->
<div class="mb-3">
    <label class="form-label">ID del Libro</label>
    <InputNumber class="form-control"
                 @bind-Value="idBuscar" />
</div>

<button class="btn btn-secondary mb-3"
        @onclick="BuscarLibro">
    Buscar
</button>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-danger">
        @mensaje
    </div>
}

@if (libro != null)
{
    <EditForm Model="libro"
              OnValidSubmit="GuardarCambios"
              FormName="ActualizarLibroForm">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nombre del Libro</label>
            <InputText class="form-control"
                       @bind-Value="libro.NombreLibro" />
        </div>

        <div class="mb-3">
            <label class="form-label">Autor</label>
            <InputText class="form-control"
                       @bind-Value="libro.Autor" />
        </div>

        <div class="mb-3">
            <label class="form-label">Cantidad de páginas</label>
            <InputNumber class="form-control"
                         @bind-Value="libro.NumPaginas" />
        </div>

        <div class="mb-3">
            <label class="form-label">Fecha de publicación</label>
            <InputDate class="form-control"
                       @bind-Value="libro.FechaPublicacion" />
        </div>

        <button type="submit" class="btn btn-warning">
            Guardar Cambios
        </button>

    </EditForm>
}

@code
{
    // ID ingresado para buscar el libro.
    private int? idBuscar;

    // Libro encontrado.
    private Libro? libro;

    // Busca un libro por ID
    private string mensaje = string.Empty;
    private async Task BuscarLibro()
    {
        mensaje = string.Empty;
        libro = null;

        if (idBuscar == null)
            {
            mensaje = "Debe ingresar un ID.";
            return;
            }
        try
        {
            libro = await Http.GetFromJsonAsync<Libro>($"api/libros/{idBuscar}");
            if (libro == null)
                {
                mensaje = "El ID ingresado no existe.";
                }
        }
        catch
        {
            mensaje = "El ID ingresado no existe.";
            libro = null;
        }
    }
    
    // Guarda los cambios realizados.
    private async Task GuardarCambios()
    {
        await Http.PutAsJsonAsync(
            $"api/libros/{libro!.Id}",
            libro);

        Navigation.NavigateTo("/libros");
    }
}