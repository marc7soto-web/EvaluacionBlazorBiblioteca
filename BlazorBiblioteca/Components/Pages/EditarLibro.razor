@page "/editar-libro/{Id:int}"
@rendermode InteractiveServer

@using BlazorBiblioteca.Models
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

@inject HttpClient Http
@inject IJSRuntime JS
@inject PreloadService PreloadService

<h3>Actualizar Libro desde Lista</h3>

<!-- Preload mostrado durante el proceso de actualización. -->
<Preload LoadingText="Actualizando libro..." />

@if (cargandoLibro)
{
    <div class="mt-3">
        <Alert Color="AlertColor.Info">
            Cargando información del libro...
        </Alert>
    </div>
}
else if (!string.IsNullOrEmpty(mensajeCargaError))
{
    <div class="mt-3">
        <Alert Color="AlertColor.Danger">
            @mensajeCargaError
        </Alert>
    </div>
}
else
{
    <EditForm Model="libro"
              FormName="EditarLibroForm">

        <div class="mb-3">
            <label class="form-label">Nombre del Libro</label>

            <TextInput @bind-Value="libro.NombreLibro"
                       Placeholder="Ingrese nombre del libro" />
        </div>

        <div class="mb-3">
            <label class="form-label">Autor</label>

            <TextInput @bind-Value="libro.Autor"
                       Placeholder="Ingrese nombre del autor" />
        </div>

        <div class="mb-3">
            <label class="form-label">Cantidad de páginas</label>

            <NumberInput TValue="int?"
                         @bind-Value="libro.NumPaginas"
                         Placeholder="Ingrese cantidad de páginas" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                Fecha de publicación (dd-MM-aaaa)
            </label>

            <DateInput TValue="DateTime?"
                       @bind-Value="libro.FechaPublicacion"
                       Placeholder="Seleccione una fecha" />
        </div>

        <!-- Muestra las validaciones establecidas en Libro.cs. -->
        @if (erroresValidacion.Count > 0)
        {
            <div class="mb-3">
                <Alert Color="AlertColor.Danger">
                    <strong>Revise los datos ingresados:</strong>

                    <ul class="mb-0 mt-2">
                        @foreach (var error in erroresValidacion)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </Alert>
            </div>
        }

        <!-- Botón amarillo de tamaño mediano. -->
        <Button Type="ButtonType.Button"
                Color="ButtonColor.Warning"
                Disabled="procesando"
                @onclick="ConfirmarYActualizarLibro">
            Actualizar Libro
        </Button>

        <!-- Alerta amarilla después de actualizar correctamente. -->
        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="mt-3">
                <Alert Color="AlertColor.Warning"
                       Dismissable="true">
                    @mensajeExito
                </Alert>
            </div>
        }

        <!-- Alerta roja si ocurre un error al actualizar. -->
        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="mt-3">
                <Alert Color="AlertColor.Danger"
                       Dismissable="true">
                    @mensajeError
                </Alert>
            </div>
        }

    </EditForm>
}

@code
{
    // Recibe el ID seleccionado desde la lista de libros.
    [Parameter]
    public int Id { get; set; }

    // Libro seleccionado y enlazado al formulario.
    private Libro libro = new();

    // Almacena los mensajes obtenidos desde las DataAnnotations.
    private List<string> erroresValidacion = new();

    // Controla el estado de carga inicial.
    private bool cargandoLibro = true;

    // Evita ejecutar varias veces la actualización.
    private bool procesando = false;

    private string mensajeCargaError = string.Empty;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;

    // Carga los datos del libro al abrir la página.
    protected override async Task OnInitializedAsync()
    {
        cargandoLibro = true;
        mensajeCargaError = string.Empty;

        try
        {
            var respuesta = await Http.GetAsync(
                $"api/libros/{Id}");

            if (!respuesta.IsSuccessStatusCode)
            {
                mensajeCargaError =
                    "El libro seleccionado no existe.";

                return;
            }

            var resultado =
                await respuesta.Content.ReadFromJsonAsync<Libro>();

            if (resultado == null)
            {
                mensajeCargaError =
                    "No se pudieron cargar los datos del libro.";

                return;
            }

            libro = resultado;
        }
        catch
        {
            mensajeCargaError =
                "Error al cargar los datos del libro.";
        }
        finally
        {
            cargandoLibro = false;
        }
    }

    // Valida los datos y solicita confirmación antes de actualizar.
    private async Task ConfirmarYActualizarLibro()
    {
        erroresValidacion.Clear();
        mensajeExito = string.Empty;
        mensajeError = string.Empty;

        var resultados = new List<ValidationResult>();
        var contextoValidacion = new ValidationContext(libro);

        bool datosValidos = Validator.TryValidateObject(
            libro,
            contextoValidacion,
            resultados,
            validateAllProperties: true);

        if (!datosValidos)
        {
            erroresValidacion = resultados
                .Where(resultado =>
                    !string.IsNullOrWhiteSpace(resultado.ErrorMessage))
                .Select(resultado => resultado.ErrorMessage!)
                .ToList();

            return;
        }

        bool confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            $"¿Está seguro de actualizar el libro '{libro.NombreLibro}'?");

        if (!confirmar)
        {
            return;
        }

        await GuardarCambios();
    }

    // Guarda los cambios en la base de datos mediante la API.
    private async Task GuardarCambios()
    {
        procesando = true;

        try
        {
            // Muestra el Preload durante tres segundos.
            PreloadService.Show(
                SpinnerColor.Light,
                "Actualizando libro...");

            await Task.Delay(3000);

            var respuesta = await Http.PutAsJsonAsync(
                $"api/libros/{libro.Id}",
                libro);

            if (respuesta.IsSuccessStatusCode)
            {
                mensajeExito =
                    $"Se ha actualizado el libro {libro.NombreLibro}";
            }
            else
            {
                mensajeError =
                    $"Error al actualizar Libro {libro.NombreLibro}";
            }
        }
        catch
        {
            mensajeError =
                $"Error al actualizar Libro {libro.NombreLibro}";
        }
        finally
        {
            // Oculta el Preload y habilita nuevamente el botón.
            PreloadService.Hide();
            procesando = false;
        }
    }
}