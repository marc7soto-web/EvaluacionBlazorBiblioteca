@page "/eliminar-libros"
@rendermode InteractiveServer

@using BlazorBiblioteca.Models
@using System.Net.Http.Json

@inject HttpClient Http
@inject IJSRuntime JS

<h3>Eliminar Libro</h3>

<div class="mb-3">
    <label class="form-label">ID del Libro</label>
    <InputNumber class="form-control"
                 @bind-Value="idBuscar" />
</div>

<button class="btn btn-secondary"
        @onclick="BuscarLibro">
    Buscar
</button>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-danger mt-3">
        @mensaje
    </div>
}

@if (libro != null)
{
    <hr />

    <p><strong>Id:</strong> @libro.Id</p>
    <p><strong>Libro:</strong> @libro.NombreLibro</p>
    <p><strong>Autor:</strong> @libro.Autor</p>
    <p><strong>Páginas:</strong> @libro.NumPaginas</p>

    <button class="btn btn-danger"
            @onclick="EliminarLibro">
        Eliminar Libro
    </button>
}

@code
{
    // ID ingresado para buscar el libro.
    private int? idBuscar;

    // Libro encontrado.
    private Libro? libro;

    // Busca un libro por ID
    private string mensaje = string.Empty;
    private async Task BuscarLibro()
    {
        mensaje = string.Empty;
        libro = null;

        if (idBuscar == null)
        {
            mensaje = "Debe ingresar un ID.";
            return;
        }
        try
        {
            libro = await Http.GetFromJsonAsync<Libro>($"api/libros/{idBuscar}");
            if (libro == null)
            {
                mensaje = "El ID ingresado no existe.";
            }
        }
        catch
        {
            mensaje = "El ID ingresado no existe.";
            libro = null;
        }
    }

    // Elimina el libro seleccionado
    private async Task EliminarLibro()
    {
        bool confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            $"¿Está seguro de eliminar el libro '{libro!.NombreLibro}'?");

        if (!confirmar)
        {
            return;
        }

        await Http.DeleteAsync(
            $"api/libros/{libro.Id}");

        libro = null;
    }
}