@page "/eliminar-libros"
@rendermode InteractiveServer

@using BlazorBiblioteca.Models
@using System.Net.Http.Json

@inject HttpClient Http
@inject IJSRuntime JS
@inject PreloadService PreloadService

<h3>Eliminar Libro</h3>

<!-- Preload mostrado durante el proceso de eliminación. -->
<Preload LoadingText="Eliminando libro..." />

<div class="mb-3">
    <label class="form-label">ID del Libro</label>

    <NumberInput TValue="int?"
                 @bind-Value="idBuscar"
                 Placeholder="Ingrese el ID del libro" />
</div>

<Button Type="ButtonType.Button"
        Color="ButtonColor.Secondary"
        Disabled="procesando"
        @onclick="BuscarLibro">
    Buscar
</Button>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="mt-3">
        <Alert Color="AlertColor.Danger">
            @mensajeError
        </Alert>
    </div>
}

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="mt-3">
        <Alert Color="AlertColor.Danger">
            @mensajeExito
        </Alert>
    </div>
}

@if (libro != null)
{
    <hr />

    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">@libro.NombreLibro</h5>

            <p class="card-text"><strong>ID:</strong> @libro.Id</p>
            <p class="card-text"><strong>Autor:</strong> @libro.Autor</p>
            <p class="card-text"><strong>Páginas:</strong> @libro.NumPaginas</p>
            <p class="card-text">
                <strong>Fecha de publicación:</strong>
                @(libro.FechaPublicacion?.ToShortDateString() ?? "Sin fecha")
            </p>

            <!-- Botón con contorno rojo y tamaño mediano. -->
            <Button Type="ButtonType.Button"
                    Color="ButtonColor.Danger"
                    Outline="true"
                    Disabled="procesando"
                    @onclick="EliminarLibro">
                Eliminar Libro
            </Button>
        </div>
    </div>
}

@code
{
    // ID ingresado para buscar el libro.
    private int? idBuscar;

    // Libro encontrado mediante la API.
    private Libro? libro;

    // Evita ejecutar varias solicitudes simultáneamente.
    private bool procesando = false;

    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;

    // Busca un libro por su ID.
    private async Task BuscarLibro()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;
        libro = null;

        if (idBuscar == null)
        {
            mensajeError = "Debe ingresar un ID.";
            return;
        }

        procesando = true;

        try
        {
            var respuesta = await Http.GetAsync($"api/libros/{idBuscar}");

            if (!respuesta.IsSuccessStatusCode)
            {
                mensajeError = "El ID ingresado no existe.";
                return;
            }

            libro = await respuesta.Content.ReadFromJsonAsync<Libro>();

            if (libro == null)
            {
                mensajeError = "El ID ingresado no existe.";
            }
        }
        catch
        {
            mensajeError = "Error al buscar el libro.";
            libro = null;
        }
        finally
        {
            procesando = false;
        }
    }

    // Confirma y elimina el libro seleccionado.
    private async Task EliminarLibro()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        if (libro == null)
        {
            mensajeError = "No existe un libro seleccionado para eliminar.";
            return;
        }

        bool confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            $"¿Está seguro de eliminar el libro '{libro.NombreLibro}'?");

        if (!confirmar)
        {
            return;
        }

        procesando = true;

        try
        {
            // Muestra el Preload durante dos segundos.
            PreloadService.Show(
                SpinnerColor.Light,
                "Eliminando libro...");

            await Task.Delay(2000);

            var respuesta = await Http.DeleteAsync($"api/libros/{libro.Id}");

            if (respuesta.IsSuccessStatusCode)
            {
                mensajeExito = "Libro eliminado correctamente";
                libro = null;
                idBuscar = null;
            }
            else
            {
                mensajeError = "Error al eliminar libro";
            }
        }
        catch
        {
            mensajeError = "Error al eliminar libro";
        }
        finally
        {
            PreloadService.Hide();
            procesando = false;
        }
    }
}
