@page "/agregar-libro"
@rendermode InteractiveServer

@using BlazorBiblioteca.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms

@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Agregar Libro</h3>

<EditForm Model="libro" OnValidSubmit="GuardarLibro" FormName="NuevoLibroForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Nombre del Libro</label>
        <InputText class="form-control" @bind-Value="libro.NombreLibro" />
    </div>

    <div class="mb-3">
        <label class="form-label">Autor</label>
        <InputText class="form-control" @bind-Value="libro.Autor" />
    </div>

    <div class="mb-3">
        <label class="form-label">Cantidad de páginas</label>
        <InputNumber class="form-control" @bind-Value="libro.NumPaginas" />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha de publicación</label>
        <InputDate class="form-control" @bind-Value="libro.FechaPublicacion" />
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>
</EditForm>

@code
{
    // Objeto que almacena la información ingresada.
    private Libro libro = new()
    {
        FechaPublicacion = DateTime.Today
    };

    // Guarda el libro en la base de datos.
    private async Task GuardarLibro()
    {
        Console.WriteLine("Entró a GuardarLibro");

        await Http.PostAsJsonAsync("api/libros", libro);

        Navigation.NavigateTo("/libros");
    }
}