@page "/agregar-libro"
@rendermode InteractiveServer

@using BlazorBiblioteca.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms

@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Agregar Libro</h3>

<EditForm Model="libro" OnValidSubmit="GuardarLibro" FormName="NuevoLibroForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Nombre del Libro</label>

        <TextInput @bind-Value="libro.NombreLibro"
                   Placeholder="Ingrese nombre del libro" />
    </div>

    <div class="mb-3">
        <label class="form-label">Autor</label>

        <TextInput @bind-Value="libro.Autor"
                   Placeholder="Ingrese nombre del autor" />
    </div>

    <div class="mb-3">
        <label class="form-label">Cantidad de páginas</label>

        <NumberInput TValue="int?"
                     @bind-Value="libro.NumPaginas" />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha de publicación</label>

        <DateInput TValue="DateTime?"
                   @bind-Value="libro.FechaPublicacion" />
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert alert-info mt-3">
            @mensaje
        </div>
    }
</EditForm>

@code
{
    // Objeto que almacena la información ingresada.
    private Libro libro = new();

    // Guarda el libro en la base de datos
    private string mensaje = string.Empty;

    private async Task GuardarLibro()
    {
        try
        {
            var respuesta =
                await Http.PostAsJsonAsync(
                    "api/libros",
                    libro);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje =
                    "Se ha ingresado un nuevo libro en la Biblioteca";

                libro = new Libro();
            }
            else
            {
                mensaje =
                    "Error al ingresar nuevo Libro";
            }
        }
        catch
        {
            mensaje =
                "Error al ingresar nuevo Libro";
        }
    }
}